<?xml version="1.0"?>
<!-- Exemple URDF de test (valeurs fictives de démonstration). -->
<robot name="exemple_bras_3ddl">
  <link name="base_link">
    <inertial><origin xyz="0 0 0.05"/><mass value="3.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.08" length="0.1"/></geometry></collision>
  </link>
  <link name="shoulder_link">
    <inertial><origin xyz="0 0 0.05"/><mass value="1.0"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/></inertial>
    <collision><geometry><cylinder radius="0.05" length="0.1"/></geometry></collision>
  </link>
  <link name="upper_arm">
    <inertial><origin xyz="0 0 0.15"/><mass value="2.0"/><inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.001"/></inertial>
    <collision><origin xyz="0 0 0.15"/><geometry><box size="0.06 0.06 0.3"/></geometry></collision>
  </link>
  <link name="forearm">
    <inertial><origin xyz="0 0 0.125"/><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0005"/></inertial>
    <collision><origin xyz="0 0 0.125"/><geometry><cylinder radius="0.03" length="0.25"/></geometry></collision>
  </link>
  <link name="tool"/>
  <joint name="j1_lacet" type="revolute"><parent link="base_link"/><child link="shoulder_link"/><origin xyz="0 0 0.1" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="20" velocity="2"/></joint>
  <joint name="j2_epaule" type="revolute"><parent link="shoulder_link"/><child link="upper_arm"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/><limit lower="-1.57" upper="1.57" effort="10" velocity="2"/></joint>
  <joint name="j3_coude" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.3"/><axis xyz="0 1 0"/><limit lower="-2.3" upper="2.3" velocity="2"/></joint>
  <joint name="outil_fixe" type="fixed"><parent link="forearm"/><child link="tool"/><origin xyz="0 0 0.25"/></joint>
</robot>
